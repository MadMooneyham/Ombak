# At rest: what the render costs with nothing sounding, stopped (as at power-on) and after playing has rung out
wait 3000
expect voices 0
expect bench_avg0 >-1
expect bench_avg1 >-1
expect bench_avg2 >-1
expect bench_avg3 >-1
expect bench_avg4 >-1
expect bench_avg5 >-1
expect bench_avg6 >-1
expect bench_avg7 >-1
tap SEQ
tapkey w2
wait 8000
tap SEQ
wait 40000
expect playing 0
expect voices 0
expect bench_avg0 >-1
expect bench_avg1 >-1
expect bench_avg2 >-1
expect bench_avg3 >-1
expect bench_avg4 >-1
expect bench_avg5 >-1
expect bench_avg6 >-1
expect bench_avg7 >-1
