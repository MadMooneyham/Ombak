turn PRESET 2
wait 200
expect p0 3
expect p12 25
tap SEQ
wait 100
tapkey w0
wait 9000
tapkey w2
wait 10000
tapkey w4
wait 12000
expect playing 1
expect bpm <8
shot still.png
key b6 down
wait 6000
key b6 up
